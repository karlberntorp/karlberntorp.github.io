---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Content, frontmatter } from '../content/research.md';
import { publications } from '../lib/publications';
import highlightsData from '../data/research-highlights.json';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

type Highlight = {
  publicationId: string;
  theme: string;
  image: string;
  alt: string;
  caption: string;
  credit: string;
  sourceUrl: string;
};
const highlights = highlightsData as Highlight[];

const themes = [
  { key: 'planning-control', title: 'Planning and control', description: 'Safe decisions and feasible motion for systems with dynamic constraints.', ids: ['Berntorp2020jan', 'Berntorp2018dec'] },
  { key: 'localization-estimation', title: 'Localization and estimation', description: 'Reliable position and state estimates from imperfect sensor measurements.', ids: ['Berntorp2016e', 'Berntorp2024nov'] },
  { key: 'robot-autonomy', title: 'Mobile manipulation and robot autonomy', description: 'Methods that bring sensing, planning, and control together on physical robots.', ids: ['Greiff2025jan'] },
];
const publicationById = new Map(publications.map((paper) => [paper.id, paper]));
for (const theme of themes) {
  if (!highlights.some((highlight) => highlight.theme === theme.key)) throw new Error(`Research theme ${theme.key} has no figure.`);
  for (const id of theme.ids) {
    if (!publicationById.has(id)) throw new Error(`Representative publication ${id} was not found in the bibliography.`);
  }
}
for (const highlight of highlights) {
  if (!themes.some((theme) => theme.key === highlight.theme)) throw new Error(`Unknown research theme ${highlight.theme}.`);
  if (!publicationById.has(highlight.publicationId)) throw new Error(`Research highlight publication ${highlight.publicationId} was not found in the bibliography.`);
  if (!highlight.image.startsWith('/research/')) throw new Error(`Research image must be a local /research/ URL: ${highlight.image}`);
  if (!existsSync(join(process.cwd(), 'public', highlight.image.slice(1)))) throw new Error(`Research image was not found: ${highlight.image}`);
}
---

<SiteLayout title={frontmatter.title} description={frontmatter.description}>
  <div class="container">
    <header class="page-intro">
      <p class="eyebrow">Research</p>
      <h1>Research that meets the real world.</h1>
      <p>{frontmatter.lead}</p>
    </header>
    <div class="research-content prose"><Content /></div>
    <section class="representative" aria-labelledby="highlights-heading">
      <div class="section-heading"><h2 id="highlights-heading">Research highlights</h2><a class="text-link" href="/publications/">Full publication list</a></div>
      <div class="themes">
        {themes.map((theme) => <section class="theme" aria-labelledby={`highlight-${theme.key}`}>
          <div class="theme-media">
            {highlights.filter((item) => item.theme === theme.key).map((highlight) => <figure>
              <div class="figure-frame"><img src={highlight.image} alt={highlight.alt} loading="lazy" decoding="async" /></div>
              <figcaption>{highlight.caption} <span class="credit">Credit: <a href={highlight.sourceUrl} target="_blank" rel="noopener noreferrer">{highlight.credit}<span class="sr-only"> (opens in a new tab)</span></a></span></figcaption>
            </figure>)}
          </div>
          <div class="theme-copy">
            <p class="eyebrow">Research area</p>
            <h3 id={`highlight-${theme.key}`}>{theme.title}</h3>
            <p class="theme-description">{theme.description}</p>
            <p class="paper-label">Representative papers</p>
            <ul>{[...new Set([...theme.ids, ...highlights.filter((item) => item.theme === theme.key).map((item) => item.publicationId)])].map((id) => {
              const paper = publicationById.get(id);
              return paper && <li><a href={`/publications/#${paper.id}`}>{paper.title}</a><span>{paper.year}</span></li>;
            })}</ul>
          </div>
        </section>)}
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .research-content { padding-bottom: 2.3rem; }
  .research-content :global(h2) { scroll-margin-top: 2rem; }
  .representative { padding-block: 2rem 1.5rem; }
  .themes { display: grid; gap: 1.5rem; }
  .theme { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); border: 1px solid var(--line); background: var(--soft); }
  .theme-media { min-width: 0; display: grid; align-content: start; gap: 1rem; padding: 1rem; background: white; border-right: 1px solid var(--line); }
  figure { margin: 0; }
  .figure-frame { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: #f4f7f9; }
  .figure-frame img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }
  figcaption { padding: .7rem .15rem .15rem; color: #42576b; font-size: .8rem; line-height: 1.5; }
  .credit { display: block; margin-top: .3rem; color: var(--muted); font-size: .75rem; }
  .credit a { color: inherit; }
  .theme-copy { min-width: 0; padding: clamp(1.4rem, 3vw, 2.2rem); }
  .theme-copy .eyebrow { margin-bottom: .55rem; }
  .theme h3 { margin: 0 0 .65rem; font-family: var(--serif); font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .theme-description { margin-bottom: 1.45rem; color: #52677a; font-family: var(--serif); font-size: 1.06rem; line-height: 1.58; }
  .paper-label { margin-bottom: .55rem; color: var(--navy); font-size: .76rem; font-weight: 700; letter-spacing: .065em; text-transform: uppercase; }
  .theme ul { list-style: none; padding: .9rem 0 0; margin: 0; border-top: 1px solid var(--line); }
  .theme li + li { margin-top: .85rem; }
  .theme li a { display: block; font-family: var(--serif); font-size: .98rem; font-weight: 600; line-height: 1.38; text-decoration: none; }
  .theme li a:hover { text-decoration: underline; }
  .theme li span { color: var(--muted); font-size: .75rem; }
  @media (max-width: 800px) { .theme { grid-template-columns: 1fr; } .theme-media { border-right: 0; border-bottom: 1px solid var(--line); } }
</style>
