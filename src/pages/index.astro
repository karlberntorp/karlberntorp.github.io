---
import SiteLayout from '../layouts/SiteLayout.astro';
import { frontmatter as home } from '../content/home.md';
import { Content as ExperienceContent } from '../content/cv.md';
import { frontmatter as selectedWork } from '../content/selected-work.md';
import { publications } from '../lib/publications';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const selections = selectedWork.papers as { id: string; summary: string }[];
const selected = selections.flatMap(({ id, summary }) => {
  const paper = publications.find((item) => item.id === id);
  if (!paper) throw new Error(`Selected publication ${id} was not found in the bibliography.`);
  return paper ? [{ paper, summary }] : [];
});
const portraitFile = ['portrait.webp', 'portrait.jpg', 'portrait.png'].find((name) => existsSync(join(process.cwd(), 'public', name)));
---

<SiteLayout title="Home" description={home.description}>
  <section class="hero">
    <div class:list={['container', 'hero-grid', { 'with-portrait': portraitFile }]}>
      <div>
        <p class="eyebrow">Research leader · Robotics &amp; autonomy</p>
        <h1>Karl Berntorp</h1>
        <p class="hero-lead">{home.lead}</p>
        <dl class="hero-metrics" aria-label="Research output">
          <div>
            <dt>Publications</dt>
            <dd><span aria-hidden="true">≈130</span><span class="sr-only">Approximately 130</span></dd>
          </div>
          <div>
            <dt>Patents</dt>
            <dd><span aria-hidden="true">≈50</span><span class="sr-only">Approximately 50</span></dd>
          </div>
          <div>
            <dt>Companies founded or co-founded</dt>
            <dd>2</dd>
          </div>
        </dl>
        <div class="hero-actions">
          <a class="button" href="/research/">Explore research <span aria-hidden="true">→</span></a>
          <a class="button button-secondary" href="#experience">Experience <span aria-hidden="true">↓</span></a>
        </div>
        <nav class="hero-quick-links" aria-label="Profile links">
          <a href="mailto:karl.o.berntorp@ieee.org">Email</a>
          <a href="https://scholar.google.com/citations?user=cwUgs64AAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
          <a href="https://orcid.org/0000-0002-6809-6657" target="_blank" rel="noopener noreferrer">ORCID <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </nav>
      </div>
      <aside class:list={['hero-aside', { 'has-portrait': portraitFile }]} aria-label="Current role and research areas">
        {portraitFile && <img class="portrait" src={`/${portraitFile}`} alt="Karl Berntorp" width="200" height="250" decoding="async" />}
        <div class="hero-aside-rule" aria-hidden="true"></div>
        <p class="eyebrow">Current role</p>
        <p class="aside-role">Principal Research Scientist</p>
        <p class="aside-place">Chewy</p>
        <div class="aside-divider"></div>
        <p class="eyebrow">Focus</p>
        <p class="aside-focus">Mobile manipulation<br />Autonomous systems<br />Planning &amp; estimation</p>
      </aside>
    </div>
  </section>

  <section id="experience" class="container experience-section" aria-labelledby="experience-heading">
    <div class="section-heading"><h2 id="experience-heading">Experience</h2></div>
    <div class="prose"><ExperienceContent /></div>
  </section>

  <section class="selected-section" aria-labelledby="selected-heading">
    <div class="container">
      <div class="section-heading"><h2 id="selected-heading">Selected work</h2><a class="text-link" href="/publications/">All publications</a></div>
      <div class="paper-grid">
        {selected.map(({ paper, summary }) => <article class="paper-card">
          <p class="paper-meta">{paper.year} <span aria-hidden="true">/</span> {paper.venue}</p>
          <h3><a href={`/publications/#${paper.id}`}>{paper.title}</a></h3>
          <p class="paper-summary">{summary}</p>
          <a class="paper-arrow" href={`/publications/#${paper.id}`} aria-label={`View publication: ${paper.title}`}><span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>

  <section class="container connect-section" aria-labelledby="connect-heading">
    <div>
      <p class="eyebrow">Connect</p>
      <h2 id="connect-heading">Working across research and practice.</h2>
    </div>
    <div>
      <p>{home.contactLead}</p>
      <a class="button" href="mailto:karl.o.berntorp@ieee.org">Get in touch <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .hero { padding-block: clamp(4rem, 8vw, 7.5rem); background: linear-gradient(118deg, #f5f8fb 0%, #fff 68%); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(230px, .8fr); align-items: end; gap: clamp(2.5rem, 8vw, 7rem); }
  .hero-grid.with-portrait { align-items: start; }
  h1 { max-width: 780px; margin-bottom: 1.45rem; }
  .hero-lead { max-width: 650px; margin-bottom: 1.8rem; color: #3e5368; font-family: var(--serif); font-size: clamp(1.2rem, 2.2vw, 1.6rem); line-height: 1.55; }
  .hero-metrics { display: flex; flex-wrap: wrap; gap: 1rem clamp(1rem, 3vw, 2rem); max-width: 650px; margin: 0 0 2rem; padding: 1.25rem 0 0; border-top: 1px solid #cad9e5; }
  .hero-metrics div { display: flex; flex: 1 1 9rem; flex-direction: column; }
  .hero-metrics dd { margin: 0; color: var(--navy); font-family: var(--serif); font-size: clamp(2.15rem, 4vw, 3rem); font-weight: 600; letter-spacing: -.04em; line-height: 1.1; }
  .hero-metrics dt { margin-top: .25rem; color: var(--blue-dark); font-size: .78rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .hero-metrics dd { order: -1; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .hero-quick-links { display: flex; flex-wrap: wrap; gap: .35rem 1.25rem; margin-top: 1.3rem; }
  .hero-quick-links a { color: var(--blue-dark); font-size: .83rem; font-weight: 600; text-decoration-color: #9bb7d0; text-underline-offset: .2em; }
  .hero-quick-links a:hover { text-decoration-color: currentColor; }
  .hero-aside { padding: 0 0 .3rem 1.7rem; border-left: 1px solid #cad9e5; }
  .hero-aside.has-portrait { padding-left: 0; border-left: 0; }
  .portrait { display: block; width: 200px; max-width: 100%; height: auto; margin-bottom: 1.5rem; border: 1px solid var(--line); background: var(--soft); }
  .hero-aside-rule { width: 3rem; height: 3px; margin-bottom: 2rem; background: var(--blue); }
  .hero-aside .eyebrow { margin-bottom: .45rem; }
  .aside-role { margin: 0; color: var(--navy); font-family: var(--serif); font-size: 1.42rem; line-height: 1.25; }
  .aside-place { margin: .2rem 0 0; color: var(--muted); }
  .aside-divider { height: 1px; margin-block: 1.5rem; background: var(--line); }
  .aside-focus { margin: 0; color: #3e5368; line-height: 1.8; }
  .experience-section { padding-block: 5.5rem 6rem; scroll-margin-top: 1rem; }
  .selected-section { padding-block: 4.7rem 5.5rem; background: var(--soft); }
  .selected-section .section-heading { border-color: #d3dfe9; }
  .paper-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .paper-card { position: relative; min-height: 260px; padding: 1.6rem 1.7rem 3.4rem; border: 1px solid var(--line); background: white; box-shadow: 0 2px 4px rgb(18 42 68 / 2%); }
  .paper-meta { margin-bottom: .65rem; color: var(--muted); font-size: .78rem; font-weight: 700; letter-spacing: .025em; }
  .paper-meta span { color: #a4b2c0; padding-inline: .35rem; }
  .paper-card h3 { margin-bottom: .55rem; font-family: var(--serif); font-size: 1.42rem; line-height: 1.3; }
  .paper-card h3 a { color: var(--navy); text-decoration: none; }
  .paper-card h3 a:hover { color: var(--blue); text-decoration: underline; }
  .paper-summary { margin: 0; color: #53677b; font-size: .91rem; line-height: 1.6; }
  .paper-arrow { position: absolute; right: 1.6rem; bottom: 1.25rem; font-size: 1.3rem; text-decoration: none; }
  .connect-section { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 8vw, 7rem); align-items: center; padding-block: 6rem 1rem; }
  .connect-section h2 { max-width: 500px; margin: 0; }
  .connect-section p:not(.eyebrow) { max-width: 400px; color: #53677b; font-family: var(--serif); font-size: 1.24rem; line-height: 1.6; }
  @media (max-width: 800px) { .hero-grid { grid-template-columns: 1fr; } .hero-aside { max-width: 480px; } }
  @media (max-width: 680px) { .hero { padding-block: 3.7rem 4.2rem; } .experience-section, .selected-section { padding-block: 3.7rem; } .paper-grid, .connect-section { grid-template-columns: 1fr; } .paper-card { min-height: 0; } .connect-section { padding-block: 4rem 0; } }
</style>
