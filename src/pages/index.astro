---
import SiteLayout from '../layouts/SiteLayout.astro';
import { frontmatter as home } from '../content/home.md';
import { frontmatter as experience } from '../content/cv.md';
import HomeHero from '../components/HomeHero.astro';
import SelectedImpact from '../components/SelectedImpact.astro';
import ExperienceSummary from '../components/ExperienceSummary.astro';
import SelectedResearch from '../components/SelectedResearch.astro';
import { impactHighlights } from '../data/impact-highlights';
import { frontmatter as selectedWork } from '../content/selected-work.md';
import { publications } from '../lib/publications';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

const selections = selectedWork.papers as { id: string; summary: string }[];
const selected = selections.flatMap(({ id, summary }) => {
  const paper = publications.find((item) => item.id === id);
  if (!paper) throw new Error(`Selected publication ${id} was not found in the bibliography.`);
  return paper ? [{ paper, summary }] : [];
});
const portraitFile = ['portrait.webp', 'portrait.jpg', 'portrait.png'].find((name) => existsSync(join(process.cwd(), 'public', name)));
---

<SiteLayout title="Home" description={home.description}>
  <HomeHero title={home.title} lead={home.lead} portraitFile={portraitFile} />
  <SelectedImpact items={impactHighlights} />
  <ExperienceSummary entries={experience.entries} supporting={experience.supporting} />
  <SelectedResearch selected={selected} />

  <section class="container connect-section" aria-labelledby="connect-heading">
    <div>
      <p class="eyebrow">Connect</p>
      <h2 id="connect-heading">Working across research and practice.</h2>
    </div>
    <div>
      <p>{home.contactLead}</p>
      <a class="button" href="mailto:karl.o.berntorp@ieee.org">Get in touch <span aria-hidden="true">→</span></a>
    </div>
  </section>
</SiteLayout>

<style>
  .connect-section { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(2rem, 8vw, 7rem); align-items: center; padding-block: 6rem 1rem; }
  .connect-section h2 { max-width: 500px; margin: 0; }
  .connect-section p:not(.eyebrow) { max-width: 400px; color: #53677b; font-family: var(--serif); font-size: 1.24rem; line-height: 1.6; }

  @media (max-width: 680px) { .connect-section { grid-template-columns: 1fr; padding-block: 4rem 0; } }
</style>
