---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { impactProjects } from '../../lib/impact-projects';

export function getStaticPaths() {
  return impactProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: (typeof impactProjects)[number] }
const { project } = Astro.props;
const { Content } = project;
---

<SiteLayout title={project.title} description={project.description}>
  <article class="container impact-project">
    <header class="page-intro">
      <p class="eyebrow">Selected impact</p>
      <h1>{project.title}</h1>
      <p>{project.description}</p>
    </header>
    <div class="prose"><Content /></div>
    <nav class="impact-navigation" aria-label="Impact navigation">
      <a href="/#impact-heading"><span aria-hidden="true">← </span>Back to Selected impact</a>
      <a href="/#experience">Experience <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</SiteLayout>

<style>
  .impact-project { max-width: 900px; }
  .page-intro { max-width: 850px; }
  .page-intro h1 { font-size: clamp(2.35rem, 5vw, 4rem); }
  .impact-navigation { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); font-size: .9rem; font-weight: 600; }
</style>
