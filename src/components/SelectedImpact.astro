---
import type { ImpactHighlight } from '../data/impact-highlights';
interface Props { items: ImpactHighlight[] }
const { items } = Astro.props;
---

<section class="container impact-section" aria-labelledby="impact-heading">
  <div class="section-heading"><h2 id="impact-heading">Selected impact</h2></div>
  <div class="impact-grid">
    {items.map((item) => <article class="impact-card" aria-labelledby={`${item.id}-heading`}>
      <h3 id={`${item.id}-heading`}>{item.heading}</h3>
      <p>{item.description}</p>
    </article>)}
  </div>
</section>

<style>
  .impact-section { padding-block: 4rem 0; }
  .impact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .impact-card { padding: 1.5rem; border: 1px solid var(--line); background: var(--soft); }
  .impact-card h3 { font-family: var(--serif); font-size: 1.45rem; line-height: 1.3; margin-bottom: 1rem; }
  .impact-card p { margin: 0; color: #53677b; font-size: .95rem; }
  @media (max-width: 1000px) { .impact-grid { grid-template-columns: 1fr; } }
</style>
