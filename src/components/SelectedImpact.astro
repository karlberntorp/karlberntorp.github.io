---
import type { ImpactHighlight } from '../data/impact-highlights';
import { impactProjectById } from '../lib/impact-projects';
interface Props { items: ImpactHighlight[] }
const { items } = Astro.props;
---

<section class="container impact-section" aria-labelledby="impact-heading">
  <div class="section-heading"><h2 id="impact-heading">Selected impact</h2></div>
  <div class="impact-grid">
    {items.map((item) => <article class="impact-card" aria-labelledby={`${item.id}-heading`}>
      <h3 id={`${item.id}-heading`}><a href={impactProjectById.get(item.id)!.href}>{item.heading}</a></h3>
      <p>{item.description}</p>
      <a class="explore-link" href={impactProjectById.get(item.id)!.href}>Explore the work<span class="sr-only">: {item.heading}</span> <span aria-hidden="true">→</span></a>
    </article>)}
  </div>
</section>

<style>
  .impact-section { padding-block: 4rem 0; }
  .impact-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .impact-card { display: flex; flex-direction: column; padding: 1.5rem; border: 1px solid var(--line); background: var(--soft); }
  .impact-card h3 { font-family: var(--serif); font-size: 1.45rem; line-height: 1.3; margin-bottom: 1rem; }
  .impact-card h3 a { color: inherit; text-decoration: none; }
  .impact-card h3 a:hover { text-decoration: underline; }
  .impact-card p { margin: 0 0 1.2rem; color: #53677b; font-size: .95rem; }
  .explore-link { align-self: flex-start; display: inline-block; margin-top: auto; font-size: .9rem; font-weight: 600; }
  @media (max-width: 1000px) { .impact-grid { grid-template-columns: 1fr; } }
</style>
