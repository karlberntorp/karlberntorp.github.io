---
import type { Publication } from '../lib/publications';
import { expandedVenues, type ResearchHighlight } from '../lib/research-highlights';
interface Props { figure: ResearchHighlight; paper: Publication; overview?: boolean }
const { figure, paper, overview = false } = Astro.props;
---

<figure class:list={{ overview }}>
  <div class="figure-frame"><img src={figure.image} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" decoding="async" /></div>
  <figcaption>
    {figure.caption}
    <span class="source"><a href={figure.sourceUrl} target="_blank" rel="noopener noreferrer">{figure.sourceLabel ?? 'From'} <cite>{paper.title}</cite>, {expandedVenues[paper.venue] ?? paper.venue} ({paper.year}).<span class="sr-only"> (opens in a new tab)</span></a></span>
    {figure.credit && <span class="source">{figure.credit}</span>}
    {!overview && <a class="full-size" href={figure.image} target="_blank" rel="noopener noreferrer">View full-size figure<span class="sr-only"> (opens in a new tab)</span></a>}
  </figcaption>
</figure>

<style>
  figure { margin: 0; }
  .figure-frame { background: #f4f7f9; }
  img { display: block; width: 100%; height: auto; }
  img[src$='.svg'] { max-width: 560px; margin-inline: auto; }
  figcaption { padding: .9rem .15rem .15rem; color: #42576b; font-size: .85rem; line-height: 1.55; }
  .source { display: block; margin-top: .3rem; color: var(--muted); font-size: .75rem; }
  .source a { color: inherit; }
  cite { font-style: normal; }
  .full-size { display: inline-block; margin-top: .65rem; font-size: .8rem; }
  .overview .figure-frame { position: relative; aspect-ratio: 16 / 10; overflow: hidden; }
  .overview img { position: absolute; inset: 0; height: 100%; object-fit: contain; }
  .overview figcaption { padding-top: .7rem; font-size: .8rem; }
</style>
