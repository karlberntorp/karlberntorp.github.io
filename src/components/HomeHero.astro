---
interface Props { title: string; eyebrow: string; lead: string; portraitFile?: string }
const { title, eyebrow, lead, portraitFile } = Astro.props;
---
  <section class="hero">
    <div class:list={['container', 'hero-grid', { 'with-portrait': portraitFile }]}>
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
        <p class="hero-lead">{lead}</p>
        <div class="hero-actions">
          <a class="button" href="#experience">Experience <span aria-hidden="true">↓</span></a>
          <a class="button button-secondary" href="/research/">Explore research <span aria-hidden="true">→</span></a>
        </div>
        <dl class="hero-metrics" aria-label="Research credentials">
          <div>
            <dt>publications</dt>
            <dd><span aria-hidden="true">≈130</span><span class="sr-only">Approximately 130</span></dd>
          </div>
          <div>
            <dt>granted US patents</dt>
            <dd><span aria-hidden="true">≈50</span><span class="sr-only">Approximately 50</span></dd>
          </div>
        </dl>
      </div>
      <aside class:list={['hero-aside', { 'has-portrait': portraitFile }]} aria-label="Current role and profile links">
        {portraitFile && <img class="portrait" src={`/${portraitFile}`} alt="Karl Berntorp" width="200" height="250" decoding="async" />}
        <div class="hero-aside-rule" aria-hidden="true"></div>
        <p class="eyebrow">Current role</p>
        <p class="aside-role">Principal Research Scientist</p>
        <p class="aside-place">Chewy</p>
        <nav class="aside-links" aria-label="Profile links">
          <a href="mailto:karl.o.berntorp@ieee.org">Email</a>
          <a href="https://scholar.google.com/citations?user=cwUgs64AAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
        </nav>
      </aside>
    </div>
  </section>

<style>

  .hero { padding-block: clamp(2.5rem, 5vw, 4rem); background: linear-gradient(118deg, #f5f8fb 0%, #fff 68%); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.9fr) minmax(230px, .8fr); align-items: end; gap: clamp(2.5rem, 8vw, 7rem); }
  .hero-grid.with-portrait { align-items: start; }
  h1 { max-width: 780px; margin-bottom: 1rem; }
  .hero-metrics { display: flex; flex-wrap: wrap; gap: .35rem .6rem; margin: 1.25rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.5; }
  .hero-metrics div { display: flex; align-items: baseline; gap: .3rem; white-space: nowrap; }
  .hero-metrics div + div::before { content: '·'; order: -2; margin-right: .3rem; }
  .hero-metrics dt { margin: 0; }
  .hero-metrics dd { order: -1; margin: 0; font-weight: 600; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
  .hero-aside { padding: 0 0 .3rem 1.7rem; border-left: 1px solid #cad9e5; }
  .hero-aside.has-portrait { padding-left: 0; border-left: 0; }
  .portrait { display: block; width: 200px; max-width: 100%; height: auto; margin-bottom: 1.5rem; border: 1px solid var(--line); background: var(--soft); }
  .hero-aside-rule { width: 3rem; height: 3px; margin-bottom: 2rem; background: var(--blue); }
  .hero-aside .eyebrow { margin-bottom: .45rem; }
  .aside-role { margin: 0; color: var(--navy); font-family: var(--serif); font-size: 1.42rem; line-height: 1.25; }
  .aside-place { margin: .2rem 0 0; color: var(--muted); }
  .aside-links { display: flex; flex-wrap: wrap; gap: .35rem 1rem; margin-top: .85rem; }
  .aside-links a { color: var(--blue-dark); font-size: .82rem; font-weight: 700; text-decoration-color: #9bb7d0; text-underline-offset: .2em; }
  .aside-links a:hover { text-decoration-color: currentColor; }
  .hero-lead { max-width: 60ch; margin-bottom: 2rem; color: #53677b; font-size: clamp(1.1rem, 2vw, 1.3rem); line-height: 1.6; }
  @media (max-width: 800px) { .hero-grid { grid-template-columns: 1fr; } .hero-aside { max-width: 480px; } }
</style>
