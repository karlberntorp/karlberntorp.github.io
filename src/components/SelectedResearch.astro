---
import type { publications } from '../lib/publications';
interface Props { selected: { paper: (typeof publications)[number]; summary: string }[] }
const { selected } = Astro.props;
---
  <section class="selected-section" aria-labelledby="selected-heading">
    <div class="container">
      <div class="section-heading"><h2 id="selected-heading">Selected research</h2><a class="text-link" href="/publications/">All publications</a></div>
      <div class="paper-grid">
        {selected.map(({ paper, summary }) => <article class="paper-card">
          <p class="paper-meta">{paper.year} <span aria-hidden="true">/</span> {paper.venue}</p>
          <h3><a href={`/publications/#${paper.id}`}>{paper.title}</a></h3>
          <p class="paper-summary">{summary}</p>
          <a class="paper-arrow" href={`/publications/#${paper.id}`} aria-label={`View publication: ${paper.title}`}><span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </div>
  </section>

<style>
  .selected-section { padding-block: 4.7rem 5.5rem; background: var(--soft); }
  .selected-section .section-heading { border-color: #d3dfe9; }
  .paper-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .paper-card { position: relative; min-height: 260px; padding: 1.6rem 1.7rem 3.4rem; border: 1px solid var(--line); background: white; box-shadow: 0 2px 4px rgb(18 42 68 / 2%); }
  .paper-meta { margin-bottom: .65rem; color: var(--muted); font-size: .78rem; font-weight: 700; letter-spacing: .025em; }
  .paper-meta span { color: #a4b2c0; padding-inline: .35rem; }
  .paper-card h3 { margin-bottom: .55rem; font-family: var(--serif); font-size: 1.42rem; line-height: 1.3; }
  .paper-card h3 a { color: var(--navy); text-decoration: none; }
  .paper-card h3 a:hover { color: var(--blue); text-decoration: underline; }
  .paper-summary { margin: 0; color: #53677b; font-size: .91rem; line-height: 1.6; }
  .paper-arrow { position: absolute; right: 1.6rem; bottom: 1.25rem; font-size: 1.3rem; text-decoration: none; }

  @media (max-width: 680px) { .selected-section { padding-block: 3.7rem; } .paper-grid { grid-template-columns: 1fr; } .paper-card { min-height: 0; } }
</style>
